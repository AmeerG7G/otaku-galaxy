# Otaku Galaxy web storefront — variable NAMES only. Real values live on the server.
#
# Server-only (never exposed to the browser; no NEXT_PUBLIC_ prefix):
#
# The existing API, reached from the storefront server over loopback / a private
# network — never through the browser. Required in production (no fallback):
# staging http://127.0.0.1:4001/api · production http://127.0.0.1:4000/api.
API_INTERNAL_URL=
# Port `npm start` listens on (127.0.0.1 only) — set it in the process environment,
# not in this file. Default 3000; give staging its own when both sites share a server:
# PORT=3001
# Public origin that serves /uploads images to browsers (the API's public host).
MEDIA_ORIGIN=
# Canonical public origin of this site (www redirects here). Mutating /bff routes
# accept requests only from this Origin.
SITE_ORIGIN=
# Comma-separated session sealing keys, each 32 random bytes in base64url
# (openssl rand -base64 32 | tr '+/' '-_' | tr -d '='). The first key seals new
# sessions; the others still open existing ones (rotation). Required in production.
SESSION_SEAL_KEYS=
# Shared with the API (same value in backend BFF_SHARED_SECRET): signs the
# shopper's IP so the API's rate limits stay per shopper. openssl rand -hex 32.
# Required in production.
BFF_SHARED_SECRET=
# Optional extra image origins for the Content-Security-Policy, space-separated
# (only if some product images are hosted outside MEDIA_ORIGIN).
CSP_EXTRA_IMG_ORIGINS=
