# ===== DEV — local development =====
# Copy to `.env.dev` and adjust. `.env.dev` is gitignored.
APP_ENV=dev
NODE_ENV=development
PORT=4000

# DEV DATABASE — never point this at staging or production.
DATABASE_URL=postgres://otaku_galaxy_app:change_me_dev_password@localhost:5432/otaku_galaxy
TEST_DATABASE_URL=postgres://otaku_galaxy_app:change_me_dev_password@localhost:5432/otaku_galaxy_test
MIGRATION_DATABASE_URL=

# Dev may use a clearly-marked fallback secret; staging/prod may not.
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# Fixed OTP 123456 — allowed ONLY in dev. Refused at boot in staging/prod.
DEV_OTP_ENABLED=true
DEV_OTP_CODE=123456
SMS_PROVIDER=console

PUBLIC_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
TRUST_PROXY=false
