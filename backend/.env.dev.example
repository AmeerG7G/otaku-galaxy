# ===== DEV — local development =====
# Copy to `.env.dev` and adjust. `.env.dev` is gitignored.
APP_ENV=dev
NODE_ENV=development
PORT=4000

# DEV DATABASE — never point this at staging or production.
DATABASE_URL=postgres://otaku_galaxy_app:change_me_dev_password@localhost:5432/otaku_galaxy
TEST_DATABASE_URL=postgres://otaku_galaxy_app:change_me_dev_password@localhost:5432/otaku_galaxy_test
MIGRATION_DATABASE_URL=

# Dev may use a clearly-marked fallback secret; staging/prod may not.
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10


PUBLIC_BASE_URL=http://localhost:4000
# 5173 لوحة التحكم (Vite)، 3000 احتياطي، 5599 تطبيق فلاتر على الويب
# (`flutter run -d web-server --web-port 5599`). بدون الأصل الأخير
# تنجح اللوحة ويفشل التطبيق وحده بأخطاء CORS غامضة في المتصفح.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5599
TRUST_PROXY=false

# ── Accounts are admin-managed: no SMS/OTP provider is configured or checked ──
# Registration and forgot-password create requests the dashboard resolves after a
# manual WhatsApp check. The former SMS_*/DEV_OTP_*/VERIFICATION_* keys are gone.
# RATE_LIMIT_ACCOUNT_REQUEST_MAX=10   # register/forgot-password per (phone+IP) per window
