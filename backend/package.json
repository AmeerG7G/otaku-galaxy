{
  "name": "otaku-galaxy-api",
  "version": "1.0.0",
  "description": "Majarat Al-Otaku (Otaku Galaxy) store API — shared by the Flutter mobile app and the future React admin dashboard.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "APP_ENV=dev tsx watch src/server.ts",
    "start": "node dist/server.js",
    "start:staging": "APP_ENV=staging NODE_ENV=production node dist/server.js",
    "start:prod": "APP_ENV=prod NODE_ENV=production node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "db:migrate": "APP_ENV=dev tsx scripts/migrate.ts",
    "db:migrate:staging": "APP_ENV=staging NODE_ENV=production tsx scripts/migrate.ts",
    "db:migrate:prod": "APP_ENV=prod NODE_ENV=production tsx scripts/migrate.ts",
    "db:seed": "APP_ENV=dev tsx scripts/seed.ts",
    "db:reset": "APP_ENV=dev tsx scripts/migrate.ts --reset",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@types/multer": "^2.2.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "pg": "^8.16.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.1.0",
    "@types/pg": "^8.15.4",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
