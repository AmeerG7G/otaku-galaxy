# ===== STAGING — pre-production =====
# Copy to `.env.staging` on the staging host. NEVER commit the real file.
#
# [CRITICAL] staging is hardened exactly like production: a missing or weak
# JWT_SECRET or DATABASE_URL refuses to boot, and DEV_OTP_ENABLED=true is
# rejected. Real people use this environment.
APP_ENV=staging
NODE_ENV=production
PORT=4000

# STAGING DATABASE — must be a different database from production.
DATABASE_URL=postgres://USER:PASSWORD@staging-db-host:5432/otaku_galaxy_staging
MIGRATION_DATABASE_URL=

# Required. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Must stay false/absent — a fixed OTP outside dev refuses to boot.
DEV_OTP_ENABLED=false
SMS_PROVIDER=http
SMS_BASE_URL=
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER=

PUBLIC_BASE_URL=https://staging-api.otaku-galaxy.example
CORS_ORIGINS=https://staging-admin.otaku-galaxy.example
TRUST_PROXY=1
