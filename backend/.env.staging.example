# ===== STAGING — pre-production =====
# Copy to `.env.staging` on the staging host. NEVER commit the real file.
#
# [CRITICAL] staging is hardened exactly like production: a missing or weak
# rejected. Real people use this environment.
APP_ENV=staging
NODE_ENV=production
# منفذ مختلف عن الإنتاج كي تتعايش البيئتان على خادم واحد إن لزم
# (يقابله upstream في deploy/nginx/staging-api.conf).
PORT=4001

# STAGING DATABASE — must be a different database from production.
DATABASE_URL=postgres://USER:PASSWORD@staging-db-host:5432/otaku_galaxy_staging
MIGRATION_DATABASE_URL=

# Required. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12


PUBLIC_BASE_URL=https://staging-api.otaku-galaxy.example
CORS_ORIGINS=https://staging-admin.otaku-galaxy.example
TRUST_PROXY=1

# ===== التخزين =====
# مجلد الصور المرفوعة. تحت Docker يجب أن يقابله حجم دائم (volume) وإلا
# ضاعت كل صورة رفعها المسؤول مع أول إعادة نشر.
UPLOADS_DIR=uploads
UPLOADS_PUBLIC_PATH=/uploads
# أقصى حجم للصورة الواحدة بالبايت (5 ميغابايت). يقابله `client_max_body_size`
# في nginx — أبقِ الاثنين متناسقين وإلا رُفض الملف في مكانٍ ونجح في آخر.
UPLOADS_MAX_BYTES=5242880

# ===== المنطقة الزمنية =====
# تقويم المتجر. «عيد ميلاد اليوم» و«التدوير اليومي للصور» يُحسبان بها لا
# بساعة الخادم — خادمٌ بـUTC يبدّل اليوم الثالثة فجراً ببغداد.
STORE_TIMEZONE=Asia/Baghdad

# مهلة الاتصال بمزوّد الرسائل (مللي ثانية).

# ===== حدود المعدّل (اختيارية — القيم الافتراضية معقولة) =====
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_GLOBAL_MAX=300
# RATE_LIMIT_AUTH_MAX=60
# RATE_LIMIT_LOGIN_MAX_PER_PHONE=10

# ===== رموز التحقق (اختيارية) =====

# ===== حساب المسؤول الأول =====
# يُقرآن مرة واحدة عند تشغيل البذر لإنشاء أول مسؤول، ثم يُزالان من البيئة.
# البذر يرفض العمل في staging/prod ما لم يُضبط ALLOW_PRODUCTION_SEED=true.
# كلمة المرور لا تُطبع في أي سجلّ. الحد الأدنى 12 حرفاً والأقصى 72 بايت (حدّ bcrypt).
# الرقم بأي صيغة عراقية (07XXXXXXXXX أو +9647XXXXXXXXX) — يُخزَّن E.164.
# SEED_ADMIN_PHONE=
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_USERNAME=

# ===== الإشعارات الفورية (Firebase Cloud Messaging) =====
# `console`/`noop` مرفوضان هنا — إشعارٌ لا يصل هو عطل صامت.
PUSH_PROVIDER=fcm
# من ملف حساب الخدمة في Firebase Console → Project settings → Service accounts.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# المفتاح الخاص بأسطر \n مهرّبة داخل قيمة واحدة.
FCM_PRIVATE_KEY=
PUSH_TIMEOUT_MS=10000

# ── Accounts are admin-managed: no SMS/OTP provider is configured or checked ──
# Registration and forgot-password create requests the dashboard resolves after a
# manual WhatsApp check. The former SMS_*/DEV_OTP_*/VERIFICATION_* keys are gone.
# RATE_LIMIT_ACCOUNT_REQUEST_MAX=10   # register/forgot-password per (phone+IP) per window
