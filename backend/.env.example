# ===== Server =====
PORT=4000
APP_ENV=development

# ===== PostgreSQL =====
# Connection used at runtime by the API.
DATABASE_URL=postgres://otaku_galaxy_app:change_me_dev_password@localhost:5432/otaku_galaxy
# Test database (created with the same role). Used only by npm run test.
TEST_DATABASE_URL=postgres://otaku_galaxy_app:change_me_dev_password@localhost:5432/otaku_galaxy_test
# Optional: connection used by the migration runner (falls back to DATABASE_URL).
MIGRATION_DATABASE_URL=

# ===== Auth =====
# Generate with: openssl rand -hex 32
JWT_SECRET=change_me_generate_a_long_random_hex_string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ===== Verification codes (OTP) =====
# development: fixed code 123456 (shown in logs, matches the Flutter dev mock).
# sms:      reserved for a real SMS provider (not implemented yet).
VERIFICATION_PROVIDER=development
VERIFICATION_CODE_LIFETIME_MINUTES=10
VERIFICATION_MAX_ATTEMPTS=5
# Fixed dev code (only used when VERIFICATION_PROVIDER=development).
DEVELOPMENT_OTP_CODE=123456

# ===== CORS =====
# Comma-separated origins allowed to call the API (web dashboard later).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ===== Rate limiting =====
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_AUTH_MAX=10