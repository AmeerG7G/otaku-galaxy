# ===== Server =====
PORT=4000
APP_ENV=development

# ===== PostgreSQL =====
# REQUIRED in production — the server refuses to start without a valid URL.
# Connection used at runtime by the API.
DATABASE_URL=postgres://otaku_galaxy_app:change_me_dev_password@localhost:5432/otaku_galaxy
# Test database (created with the same role). Used only by npm run test.
TEST_DATABASE_URL=postgres://otaku_galaxy_app:change_me_dev_password@localhost:5432/otaku_galaxy_test
# Optional: connection used by the migration runner (falls back to DATABASE_URL).
MIGRATION_DATABASE_URL=

# ===== Auth =====
# REQUIRED in production — the server refuses to start without it.
# Must be at least 32 characters and must not be a known/default value.
# Generate with: openssl rand -hex 32
JWT_SECRET=change_me_generate_a_long_random_hex_string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ===== Verification codes (OTP) =====
# Fixed dev code. OFF unless explicitly set to true, and FORCED off in
# production (NODE_ENV=production + DEV_OTP_ENABLED=true refuses to boot).
# Leaving this unset means real random codes are generated and sent via SMS.
DEV_OTP_ENABLED=false
DEV_OTP_CODE=123456
# Code lifetime and the per-code verification attempt ceiling.
VERIFICATION_CODE_LIFETIME_MINUTES=10
VERIFICATION_MAX_ATTEMPTS=5
# Resend throttling, applied per phone number (survives restarts, DB-backed).
VERIFICATION_MAX_SENDS_PER_WINDOW=5
VERIFICATION_RESEND_WINDOW_MINUTES=15
VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# ===== SMS provider =====
# console = print to terminal (dev only, refused in production)
# noop    = send nothing (tests only, refused in production)
# http    = generic HTTP provider, fully configured below
SMS_PROVIDER=console
# Required when SMS_PROVIDER=http:
SMS_BASE_URL=
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER=
SMS_TIMEOUT_MS=10000

# ===== Public base URL =====
# Origin used to build absolute URLs for uploaded images stored in the DB.
# Change this (and rewrite stored URLs) if the API moves to another host.
PUBLIC_BASE_URL=http://localhost:4000

# ===== Uploads =====
# Local-disk storage driver. Swap the driver in src/storage for object storage.
UPLOADS_DIR=uploads
UPLOADS_PUBLIC_PATH=/uploads
# Max size per image (5 MB).
UPLOADS_MAX_BYTES=5242880

# ===== CORS =====
# Comma-separated origins allowed to call the API (web dashboard later).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ===== Seed (development only) =====
# No admin account is created unless BOTH are set. Never printed to logs.
# Password must be at least 12 characters.
SEED_ADMIN_PHONE=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_USERNAME=

# ===== Reverse proxy =====
# Number of trusted proxy hops in front of the API (nginx = 1), or "false".
# Rate limiting keys on the client IP, so this MUST match your deployment or
# every user shares a single bucket.
TRUST_PROXY=false

# ===== Rate limiting =====
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=300
# Wide per-IP flood ceiling across all auth endpoints.
RATE_LIMIT_AUTH_MAX=60
# The real guards, keyed per (phone + IP):
RATE_LIMIT_LOGIN_MAX_PER_PHONE=10
RATE_LIMIT_OTP_VERIFY_MAX=10
RATE_LIMIT_OTP_SEND_MAX=20