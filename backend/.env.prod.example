# ===== PROD — production =====
# Copy to `.env.prod` on the production host, or supply these as real
# environment variables / secrets. NEVER commit the real file.
APP_ENV=prod
NODE_ENV=production
PORT=4000

# PRODUCTION DATABASE — never referenced from dev or staging.
DATABASE_URL=postgres://USER:PASSWORD@prod-db-host:5432/otaku_galaxy
MIGRATION_DATABASE_URL=

# Required. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

DEV_OTP_ENABLED=false
SMS_PROVIDER=http
SMS_BASE_URL=
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER=

PUBLIC_BASE_URL=https://api.otaku-galaxy.example
CORS_ORIGINS=https://admin.otaku-galaxy.example
TRUST_PROXY=1
