{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "otaku-web",
      "runtimeExecutable": "flutter",
      "runtimeArgs": [
        "run",
        "-d",
        "web-server",
        "--web-hostname",
        "127.0.0.1",
        "--web-port",
        "5599"
      ],
      "port": 5599
    },
    {
      "name": "otaku-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "backend",
      "port": 4000
    },
    {
      "name": "otaku-admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "admin",
      "port": 5173
    }
  ]
}
