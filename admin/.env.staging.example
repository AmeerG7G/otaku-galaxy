# ===== Admin Dashboard — STAGING =====
# Copy to `.env.staging`. Selected by `--mode staging`.
#
# [CRITICAL] must point at the STAGING backend. An admin using the staging
# dashboard must not be able to reach production data.
VITE_APP_ENV=staging
VITE_API_BASE_URL=https://staging-api.otakugalaxystore.com/api

# ── إشعارات هاتف المسؤول (Web Push عبر FCM) — STEP 64 ──
# إعداد تطبيق الويب من Firebase Console (Project settings → Your apps → Web)،
# ومفتاح VAPID من Cloud Messaging → Web Push certificates. ليست أسراراً (يراها
# كل متصفّح)، لكنها لكل بيئة مشروعُها. فارغة ⇒ «الإشعارات غير مُعدّة» ولا ينكسر شيء.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
